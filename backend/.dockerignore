# Usado por el build del backend (context = backend/, ver ../docker-compose.yml).
# OJO: a diferencia de .gitignore, NO excluye weights/*.pth ni *.pt: el
# contenedor los necesita para poder correr inferencia real.

.git
.venv/
venv/
__pycache__/
*.pyc

test_media/
reports/lighting_analysis/*
!reports/lighting_analysis/.gitkeep

.vscode/
.idea/
Thumbs.db
.DS_Store
