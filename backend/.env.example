# === Reporte diario de actividad por correo (backend/api/email_reports.py) ===
# SMTP puro (smtplib de la libreria estandar), pedido explicitamente asi.
# Ejemplo con Gmail: activa la verificacion en dos pasos y crea una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords --
# usa ESA como SMTP_PASSWORD, nunca la contraseña normal de la cuenta.
# Mientras SMTP_HOST quede vacio, el envio queda deshabilitado sin error (el
# hilo de fondo se lo salta) y el boton "probar ahora" del frontend responde
# con un aviso claro en vez de intentarlo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente que ve quien recibe el correo. Si se deja vacio se usa SMTP_USER.
SMTP_FROM=
# true = STARTTLS (puerto 587, el tipico de Gmail/Outlook). false = TLS
# implicito (puerto 465).
SMTP_USE_TLS=true
# Zona horaria IANA en la que la persona escribe la hora de envio (p. ej.
# "08:00" significa las 8 a.m. en ESTA zona, no en UTC).
APP_TIMEZONE=America/Bogota
