# Plantilla para backend/.env EN EL SERVIDOR (no en Windows). Copiar como
# `backend/.env` en el VM y completar con valores reales -- ese archivo esta
# en .gitignore, nunca se sube al repo.
#
# DATABASE_URL, CORS_ORIGINS y ENERGY_MODEL_DIR NO van aca: docker-compose.server.yml
# ya los sobreescribe con `environment:` (dependen de SERVER_HOST/puertos, no
# son secretos). Este archivo es solo para credenciales.

# Generar uno nuevo, no reusar el de desarrollo:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

DEVICE=auto

# === Asistente de voz (backend/api/assistant/) ===
GPT_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
ASISTENTE_REPORTS_DIR=reports/asistente

CO2_EMISSION_FACTOR_KG_PER_KWH=0.126
ENERGY_CONTEXT_CONFIG_PATH=configs/energy_context.yaml
